{
  "_version": 1,
  "_comment": "Agent Router platform config",
  "services": {
    "claude-api": {
      "label": "agent-router.claude-api",
      "host": "127.0.0.1",
      "port": 8000,
      "health": "http://127.0.0.1:8000/health",
      "plist": "agent-router.claude-api.plist"
    },
    "codex-api": {
      "label": "agent-router.codex-api",
      "host": "127.0.0.1",
      "port": 8006,
      "health": "http://127.0.0.1:8006/health",
      "plist": "agent-router.codex-api.plist"
    },
    "proxy": {
      "label": "agent-router.proxy",
      "host": "0.0.0.0",
      "port": 8001,
      "health": "http://127.0.0.1:8001/health",
      "plist": "agent-router.proxy.plist"
    }
  },
  "upstream": {
    "claude_api": "http://127.0.0.1:8000",
    "codex_api": "http://127.0.0.1:8006",
    "proxy": "http://localhost:8001/api",
    "minimax": "https://api.minimaxi.chat/v1",
    "zai": "https://api.z.ai/api/anthropic",
    "ollama": "http://127.0.0.1:11434/v1",
    "huggingface": "https://router.huggingface.co/v1",
    "openrouter": "https://openrouter.ai/api/v1"
  },
  "timeouts": {
    "connect": 10.0,
    "health_check": 5.0,
    "claude_opus": 180.0,
    "claude_sonnet": 300.0,
    "codex": 240.0,
    "minimax": 90.0,
    "zai": 180.0,
    "ollama": 180.0,
    "huggingface": 180.0,
    "openrouter": 180.0,
    "internal_api": 10.0,
    "swarm_worker": 120.0,
    "consolidation": 60.0,
    "queue_wait": 300
  },
  "swarm": {
    "workers": 3,
    "enabled": true
  },
  "cascade": {
    "enabled": true,
    "chain": [
      "huggingface",
      "ollama",
      "openrouter"
    ]
  },
  "rate_limits": {
    "claude": {
      "requests_per_min": 30,
      "tokens_per_day": 2000000,
      "label": "Claude (Opus/Sonnet)"
    },
    "codex": {
      "requests_per_min": 60,
      "tokens_per_day": 2000000,
      "label": "Codex (GPT)"
    },
    "minimax": {
      "requests_per_min": 240,
      "tokens_per_day": 8000000,
      "label": "MiniMax M2.5 (Swarm 3x)"
    },
    "zai": {
      "requests_per_min": 120,
      "tokens_per_day": 4000000,
      "label": "Z.AI (GLM-4.6)"
    }
  },
  "providers": {
    "claude": {
      "default_model": "claude-sonnet-4-6",
      "models": [
        "claude-opus-4-6",
        "claude-sonnet-4-6"
      ]
    },
    "codex": {
      "default_model": "gpt-5",
      "models": [
        "gpt-5",
        "gpt-5-mini",
        "gpt-5-codex"
      ]
    },
    "minimax": {
      "default_model": "MiniMax-M2.5",
      "models": [
        "MiniMax-M2.5"
      ]
    },
    "zai": {
      "default_model": "glm-4.6",
      "models": [
        "glm-4.6",
        "glm-4.5-air",
        "glm-4.6-think"
      ]
    },
    "ollama": {
      "default_model": "qwen2.5-coder:1.5b",
      "models": [
        "qwen2.5-coder:1.5b"
      ],
      "base_url": "http://127.0.0.1:11434/v1"
    },
    "huggingface": {
      "default_model": "openai/gpt-oss-120b:fastest",
      "models": [
        "openai/gpt-oss-120b:fastest",
        "deepseek-ai/DeepSeek-V3.2"
      ],
      "base_url": "https://router.huggingface.co/v1"
    },
    "openrouter": {
      "default_model": "openrouter/free",
      "models": [
        "openrouter/free"
      ],
      "base_url": "https://openrouter.ai/api/v1"
    }
  },
  "paths": {
    "launchagents_dir": "~/Library/LaunchAgents",
    "data_dir": "./data",
    "logs_dir": "~/.agent-router/logs",
    "analytics_dir": "~/.agent-router/analytics"
  },
  "swarm_monitor": {
    "check_interval": 60,
    "restart_cooldown": 300,
    "health_timeout": 10
  },
  "log_rotation": {
    "retention_days": 7,
    "max_size_mb": 10,
    "schedule": "daily at 00:00",
    "label": "agent-router.log-rotate"
  }
}