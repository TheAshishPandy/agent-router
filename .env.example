# Copy to .env and fill in. Loaded by your shell or a launcher; the proxy reads from os.environ.
# Provider API keys (env wins over data/config.json)
MINIMAX_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Codex mode: 'cli' (default) wraps `codex` binary via codex-api-server.py.
#             'api' uses OPENAI_API_KEY against OpenAI's API directly.
CODEX_MODE=cli

# Paths (optional — defaults shown)
# AGENT_ROUTER_DATA_DIR=./data
# AGENT_ROUTER_CONFIG=./platform.json
# CLAUDE_PATH=/usr/local/bin/claude
# CODEX_PATH=/usr/local/bin/codex
# ANALYTICS_DIR=~/.agent-router/analytics
